# Cloudinary — copy this file to .env and fill in the real value.
# .env is gitignored; .env.example is safe to commit (no secrets).
#
# Find it in the Cloudinary Console:
#   Settings (gear) → API Keys → "API environment variable"
# It looks like:  cloudinary://123456789012345:AbCdEf...@dja4ppkvq
#
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@dja4ppkvq
